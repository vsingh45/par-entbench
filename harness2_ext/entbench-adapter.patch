+"""EntBench adapter: Harness² over the Planner-as-Router multi-agent workflow.
+
+EntBench (github.com/vsingh45/par-entbench) is an enterprise multi-agent workload: a
+planner decomposes each query and assigns a model tier per subtask, and six specialists
+(SQL, MongoDB, extraction, reconciliation, tool planning, policy) execute the plan. It is
+graded by EXECUTING the generated SQL and MongoDB against live databases, so `score` is
+an exact check rather than a model judge.
+
+Unlike the other cells, the executor is not a coding agent. The harness is PaR's prompt
+set, laid out on Harness²'s component tree:
+
+    c1 systemprompt.md                       planner system prompt
+    c2 guardrails.md                         appended to every specialist
+    c3 LongTermMEMORY.md                     appended to planner and specialists
+    c4 tool_descriptions/tool_guidance.md    appended to every specialist
+    c5 sub_agents/<specialist>/AGENT.md      one prompt per specialist (+ the classifier)
+
+c6-c8 (skills, scripts, plugins) have no equivalent in this executor; `validate_tree`
+rejects them with feedback that points the improver at a supported component.
+
+Process boundary: this adapter never imports PaR or reads an EntBench task file. It
+drives `python -m entbench.rollout` in the par-entbench environment, which owns the
+answer-free task view, harness validation, ungraded rollouts and grading. Configure:
+
+    ENTBENCH_REPO     path to a par-entbench checkout (branch harness2-integration)
+    ENTBENCH_PYTHON   its interpreter (default: $ENTBENCH_REPO/.venv/bin/python)
+    ENTBENCH_ROUTER   PaR router for rollouts (default: par)
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import threading
+from pathlib import Path
+
+from .. import config
+from ..core import runmark as RM
+from ..core import tree as HT
+from ..core.spec import BenchPrompts, BenchSpec, resolve_channel_model
+from ..core.tree import SurfaceSpec
+
+TRACE_FILE = "trace.json"
+METRICS_FILE = "metrics.json"
+
+PAR_SURFACE = SurfaceSpec(
+    name="par",
+    always_on=(
+        "systemprompt.md",
+        "guardrails.md",
+        "LongTermMEMORY.md",
+        "tool_descriptions/tool_guidance.md",
+    ),
+    always_on_max=24_000,
+    always_on_cap_reason=(
+        "every always-on token is billed as input on every planner and specialist call"
+    ),
+    skill_dir="skills",
+    skill_name_rule="must_match",
+    trigger_hint=(
+        "This executor has no skills. Move `{name}`'s guidance into guardrails.md or the "
+        "relevant sub_agents/<specialist>/AGENT.md."
+    ),
+    autotrigger_file="guardrails.md",
+    trigger_line="- When {desc}, apply the `{name}` guidance.\n",
+    subagent_requires_mode=True,
+    plugin_dir=None,
+    hooks_file=None,
+    stubs=(
+        (
+            "sub_agents/README.md",
+            "<!-- c5: one prompt per PaR specialist, sub_agents/<name>/AGENT.md with "
+            "`mode: subagent` and `description:` frontmatter. The planner can only route to "
+            "the existing specialists; new names are rejected. -->\n",
+        ),
+    ),
+)
+
+
+class ParSubstrate:
+    """The PaR executor as a substrate: the editable surface core needs, nothing more.
+
+    Execution goes through EntBenchAdapter.execute, not a launcher, because the
+    executor is a fixed multi-agent workflow rather than an agent framework.
+    """
+
+    name = "par"
+
+    def surface(self) -> SurfaceSpec:
+        return PAR_SURFACE
+
+
+ENTBENCH_PROMPTS = BenchPrompts(
+    work=(
+        "Enterprise data work run by a planner and six specialist agents. The planner splits "
+        "a business question into the fewest subtasks, assigns each to a specialist (SQL, "
+        "MongoDB, document extraction, cross-source reconciliation, tool planning, policy "
+        "decisions) and picks a model size per subtask. Specialists return machine-readable "
+        "JSON that is executed against live Postgres and MongoDB, so a query that does not "
+        "run, filters the wrong rows or returns the wrong shape is a wrong answer."
+    ),
+    domain_word="task class",
+    deliverable_word="query or structured output",
+    inv_levers=(
+        "- the planner prompt (systemprompt.md): decomposition rules, when to add or omit a "
+        "specialist, and how to pick a model size per subtask\n"
+        "- guardrails.md: output-discipline rules every specialist must follow (valid JSON only, "
+        "exact field names, null for missing values)\n"
+        "- tool_descriptions/tool_guidance.md: schema facts and conventions shared by "
+        "specialists (date ranges, fiscal quarters, null handling)\n"
+        "- LongTermMEMORY.md: short, evidence-backed lessons that apply across task classes\n"
+        "- skills/, scripts/ and plugin/ do not exist in this executor; put guidance in the "
+        "files above or in a specialist prompt"
+    ),
+    dom_levers=(
+        "- sub_agents/<specialist>/AGENT.md for the specialist this task class depends on: "
+        "schema details, worked examples, join and filter conventions, and the exact output "
+        "format\n"
+        "- how a specialist should use upstream outputs it receives from earlier subtasks\n"
+        "- keep the frontmatter (`mode: subagent`, `description:`) and do not add or rename "
+        "specialists; the planner can only route to the existing six"
+    ),
+    yardstick=(
+        "Did the planner produce the minimal correct plan, and did each specialist return "
+        "parseable output that would execute and answer exactly the question asked, with the "
+        "right filters, joins, aggregation and result shape?"
+    ),
+    selection_checks=(
+        "Prefer the run whose final output answers the exact question: correct tables or "
+        "collections, filters matching every stated condition (publisher, period, status), "
+        "correct aggregation and grouping, the requested columns or fields, and valid "
+        "machine-readable output with no prose or markdown. A shorter plan with a correct "
+        "query beats a longer plan with an extra or wrong step."
+    ),
+)
+
+
+def _channels() -> dict:
+    channel = resolve_channel_model(None, None, effort="high")
+    return {"proposer": channel, "selector": channel}
+
+
+def entbench_spec() -> BenchSpec:
+    return BenchSpec(
+        name="eb",
+        runs_root=config.RUNS / "eb",
+        install_mode="par_harness",
+        prompts=ENTBENCH_PROMPTS,
+        channels=_channels(),
+        domain_word="task class",
+        leak_globs=(),
+        allow_subagents=True,
+        reserved_scripts=frozenset(),
+        proposer_deliverables="contents",
+        obs_trunc=50_000,
+    )
+
+
+_BASE_LOCK = threading.Lock()
+
+
+class EntBenchAdapter:
+    """The BenchmarkAdapter surface for EntBench, via the par-entbench rollout CLI."""
+
+    def __init__(
+        self,
+        *,
+        repo: Path | None = None,
+        python: Path | None = None,
+        router: str | None = None,
+        seed: int = 1,
+        timeout: int = 900,
+        split_file: Path | None = None,
+        rollout_cmd: list[str] | None = None,
+        spec: BenchSpec | None = None,
+    ):
+        self.repo = Path(repo or os.environ.get("ENTBENCH_REPO") or "").expanduser()
+        self.python = Path(
+            python or os.environ.get("ENTBENCH_PYTHON") or self.repo / ".venv" / "bin" / "python"
+        )
+        self.router = router or os.environ.get("ENTBENCH_ROUTER") or "par"
+        self.seed = seed
+        self.timeout = timeout
+        self.split_file = split_file
+        self._rollout_cmd = rollout_cmd or [str(self.python), "-m", "entbench.rollout"]
+        self.spec = spec or entbench_spec()
+        self.substrate = ParSubstrate()
+        self._results_root = self.spec.runs_root / "results" / self.router
+        self._tasks: dict[str, dict] | None = None
+
+    # ------------------------------------------------------------------ rollout CLI
+
+    def _cli(self, *args: str, timeout: int | None = None) -> subprocess.CompletedProcess:
+        return subprocess.run(
+            [*self._rollout_cmd, *args],
+            cwd=self.repo if self.repo.is_dir() else None,
+            capture_output=True,
+            text=True,
+            timeout=timeout or self.timeout,
+        )
+
+    def _describe(self) -> dict[str, dict]:
+        if self._tasks is None:
+            r = self._cli("describe", timeout=120)
+            if r.returncode != 0:
+                raise RuntimeError(f"entbench describe failed: {r.stderr.strip()[-800:]}")
+            self._tasks = {t["task_id"]: t for t in json.loads(r.stdout)}
+        return self._tasks
+
+    # ------------------------------------------------------------------ tasks
+
+    def tasks(self, split: str = "all") -> list[str]:
+        from .tasks import select
+
+        domains = {tid: t["task_class"] for tid, t in self._describe().items()}
+        return select(domains, split, self.split_file, benchmark="eb")
+
+    def domain_of(self, task_id: str) -> str:
+        return self._describe()[task_id]["task_class"]
+
+    def reference_domain_order(self) -> list[str]:
+        return sorted({t["task_class"] for t in self._describe().values()})
+
+    def task_prompt(self, task_id: str, *, max_chars: int = 12_000) -> str:
+        """The question and its inputs as the workflow received them; no answers or hints."""
+        t = self._describe()[task_id]
+        parts = [f"# TASK {task_id}", f"**Task class:** {t['task_class']}"]
+        if t.get("substrate"):
+            parts.append(f"**Data source:** {t['substrate']}")
+        parts.append("\n## Question\n" + str(t["query"]).strip())
+        for key, title in (
+            ("collection", "Collection"),
+            ("input_document", "Input document"),
+            ("context", "Context"),
+            ("policy_registry", "Policy registry"),
+            ("candidate_actions", "Candidate actions"),
+        ):
+            if key in t:
+                val = t[key]
+                body = val if isinstance(val, str) else json.dumps(val, indent=2)
+                parts.append(f"\n## {title}\n{body}")
+        return "\n\n".join(parts)[:max_chars]
+
+    def task_files(self, task_id: str) -> Path | None:
+        return None
+
+    # ------------------------------------------------------------------ execution
+
+    def _run_dir(self, run_id: str) -> Path:
+        return self._results_root / run_id
+
+    def execute(
+        self, task_id: str, harness_dir: Path | None, run_id: str, *, timeout: int | None = None
+    ) -> Path:
+        out = self._run_dir(run_id)
+        if RM.is_complete(out, harness_dir=harness_dir) and (out / TRACE_FILE).is_file():
+            return out
+        if out.is_dir() and any(out.iterdir()):
+            print(f"  [eb] re-rolling {run_id}: {RM.why_not(out, harness_dir=harness_dir)}")
+            shutil.rmtree(out, ignore_errors=True)
+
+        args = ["run", "--task-id", task_id, "--run-dir", str(out)]
+        args += ["--router", self.router, "--seed", str(self.seed)]
+        if harness_dir is not None:
+            args += ["--harness-dir", str(Path(harness_dir).resolve())]
+        r = self._cli(*args, timeout=timeout)
+        if r.returncode != 0 or not (out / TRACE_FILE).is_file():
+            raise RuntimeError(
+                f"EntBench rollout failed for {task_id} ({run_id}), rc={r.returncode}: "
+                f"{r.stderr.strip()[-800:]}"
+            )
+        RM.mark_complete(out, run_id=run_id, harness_dir=harness_dir)
+        return out
+
+    # ------------------------------------------------------------------ evidence
+
+    @staticmethod
+    def _trace(run_dir: Path) -> dict:
+        return json.loads((Path(run_dir) / TRACE_FILE).read_text(encoding="utf-8"))
+
+    @staticmethod
+    def _terminal_nodes(trace: dict) -> list[dict]:
+        """Nodes no other subtask depends on: what the workflow hands back."""
+        plan = trace.get("plan") or {}
+        subtasks = plan.get("subtasks") or []
+        upstream = {d for s in subtasks for d in (s.get("depends_on") or [])}
+        terminal_ids = {s["id"] for s in subtasks if s["id"] not in upstream}
+        nodes = trace.get("node_results") or []
+        picked = [n for n in nodes if n.get("subtask_id") in terminal_ids]
+        return picked or nodes[-1:]
+
+    def delivered(self, run_dir: Path) -> bool:
+        if not (Path(run_dir) / TRACE_FILE).is_file():
+            return False
+        return any(
+            n.get("output") and not n.get("error")
+            for n in self._terminal_nodes(self._trace(run_dir))
+        )
+
+    def trajectory(self, run_dir: Path, *, obs_trunc: int) -> str:
+        """Plan and every node in the shared [ACTION]/[OBSERVATION]/[ERROR] grammar.
+
+        Never includes correctness: rollouts are written ungraded, and node_correct /
+        task_correct are dropped here as a second guard.
+        """
+        p = Path(run_dir) / TRACE_FILE
+        if not p.is_file():
+            return f"(no trajectory recorded for {Path(run_dir).name})"
+        t = self._trace(run_dir)
+
+        def clip(s: str) -> str:
+            return (
+                s
+                if len(s) <= obs_trunc
+                else s[:obs_trunc] + f"\n...[{len(s) - obs_trunc} chars truncated]"
+            )
+
+        lines: list[str] = []
+        plan = t.get("plan")
+        if plan:
+            steps = [
+                f"  {s['id']}: {s['specialist']} @ {s['tier']}"
+                + (f" (after {', '.join(s['depends_on'])})" if s.get("depends_on") else "")
+                + f" — {s['description']}"
+                for s in plan.get("subtasks", [])
+            ]
+            lines.append("[ACTION] planner: decompose the question and assign model sizes")
+            lines.append(
+                "[OBSERVATION]\n"
+                + "\n".join(steps)
+                + (f"\n  rationale: {plan['cost_rationale']}" if plan.get("cost_rationale") else "")
+            )
+        else:
+            lines.append("[ERROR] planner produced no plan")
+
+        desc = {s["id"]: s["description"] for s in (plan or {}).get("subtasks", [])}
+        for n in t.get("node_results") or []:
+            lines.append(
+                f"[ACTION] {n['specialist']} ({n['tier_assigned']}, {n['model_used']}) "
+                f"on {n['subtask_id']}: {desc.get(n['subtask_id'], '')}"
+            )
+            if n.get("error"):
+                lines.append(f"[ERROR] {n['error']}")
+            else:
+                out = json.dumps(n.get("output"), indent=2, default=str)
+                lines.append(
+                    f"[OBSERVATION] tokens in={n['input_tokens']} out={n['output_tokens']} "
+                    f"latency={n['latency_ms']}ms\n{clip(out)}"
+                )
+        lines.append(f"[OBSERVATION] workflow cost ${t.get('total_cost_usd', 0.0):.5f}")
+        return "\n".join(lines)
+
+    def deliverable_files(self, run_dir: Path) -> dict[str, str]:
+        if not (Path(run_dir) / TRACE_FILE).is_file():
+            return {}
+        return {
+            f"{n['subtask_id']}.{n['specialist']}.json": json.dumps(
+                n.get("output") if not n.get("error") else {"error": n["error"]},
+                indent=2,
+                default=str,
+            )
+            for n in self._terminal_nodes(self._trace(run_dir))
+        }
+
+    def deliverable_text(self, run_dir: Path) -> str:
+        files = self.deliverable_files(run_dir)
+        if not files:
+            return "(this run produced NO output)"
+        return "\n\n".join(f"----- FILE: {k} -----\n{v}" for k, v in files.items())
+
+    # ------------------------------------------------------------------ harness
+
+    def base_harness(self) -> Path:
+        """PaR's built-in prompts as a tree, copied from the par-entbench checkout."""
+        d = self.spec.runs_root / f"_base_harness_{os.getpid()}"
+        with _BASE_LOCK:
+            if not HT.is_tree(PAR_SURFACE, d):
+                src = self.repo / "base_harness"
+                if not HT.is_tree(PAR_SURFACE, src):
+                    raise RuntimeError(
+                        f"{src} is not a PaR harness; set ENTBENCH_REPO to a par-entbench "
+                        f"checkout on the harness2-integration branch"
+                    )
+                HT.write_tree(PAR_SURFACE, HT.read_tree(PAR_SURFACE, src), d)
+        return d
+
+    def validate_tree(self, tree: dict[str, str]) -> None:
+        """Defer to par-entbench's own validator, so the two can never disagree."""
+        with tempfile.TemporaryDirectory() as td:
+            d = HT.write_tree(PAR_SURFACE, tree, Path(td) / "h", stubs=False)
+            r = self._cli("validate", "--harness-dir", str(d), timeout=120)
+        if r.returncode == 2:
+            raise ValueError(r.stderr.strip())
+        if r.returncode != 0:
+            raise RuntimeError(f"entbench validate crashed: {r.stderr.strip()[-800:]}")
+
+    def preflight(self) -> None:
+        if not self.repo.is_dir():
+            raise RuntimeError("Set ENTBENCH_REPO to a par-entbench checkout")
+        if not Path(self._rollout_cmd[0]).exists() and self._rollout_cmd[0] == str(self.python):
+            raise RuntimeError(
+                f"{self.python} not found; in par-entbench run: python -m venv .venv && "
+                f".venv/bin/pip install -e ."
+            )
+        if not os.environ.get("ANTHROPIC_API_KEY"):
+            raise RuntimeError("ANTHROPIC_API_KEY is not set; PaR rollouts call the Claude API")
+        self._describe()
+        self.base_harness()
+
+    # ------------------------------------------------------------------ grading
+
+    def score(self, run_dir: Path, task_id: str) -> dict | None:
+        """Execution-based grade from the live databases; None if grading itself failed."""
+        try:
+            r = self._cli("score", "--task-id", task_id, "--run-dir", str(run_dir), timeout=300)
+        except subprocess.TimeoutExpired:
+            return None
+        if r.returncode != 0:
+            return None
+        got = json.loads(r.stdout)
+        return {
+            "n_passed": int(got["n_passed"]),
+            "n_criteria": int(got["n_criteria"]),
+            "all_pass": bool(got["correct"]),
+        }
+
+
+__all__ = ["EntBenchAdapter", "ParSubstrate", "PAR_SURFACE", "ENTBENCH_PROMPTS", "entbench_spec"]
