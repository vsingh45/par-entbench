+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""EntBench adapter tests against a REAL par-entbench checkout.
+
+Everything runs for real -- the rollout CLI, PaR's planner and dispatcher, harness
+loading and validation, and Harness²'s recursion, selection and library -- except the
+two external services: the Claude API is replaced by a deterministic fake client, and
+the database grader by a check on the generated SQL.
+
+The fake SQL specialist writes the correct Q4 filter only when its system prompt carries
+the lesson the scripted improver adds, so a successful refinement is observable end to end.
+
+Skipped unless ENTBENCH_REPO points at a par-entbench checkout (harness2-integration
+branch) with its .venv installed.
+"""
+
+import dataclasses
+import json
+import os
+import tempfile
+import textwrap
+import unittest
+from pathlib import Path
+
+from harness2.cli._common import make_adapter
+from harness2.core import judge, schedule
+from harness2.core.proposer import Proposer, Reply
+from harness2.core.spec import ChannelSpec
+
+REPO = Path(os.environ.get("ENTBENCH_REPO", "")).expanduser()
+PAR_PY = REPO / ".venv" / "bin" / "python"
+LESSON = "Q4 means fiscal_quarter = 4; always filter on it."
+CORRECT = "SELECT SUM(amount_usd) FROM consumption_facts WHERE publisher = 'Adobe' AND fiscal_year = 2024 AND fiscal_quarter = 4"
+WRONG = (
+    "SELECT SUM(amount_usd) FROM consumption_facts WHERE publisher = 'Adobe' AND fiscal_year = 2024"
+)
+
+FAKE_ROLLOUT = textwrap.dedent(
+    f"""
+    import json, sys
+    from types import SimpleNamespace
+    import anthropic
+
+    class Fake:
+        def __init__(self, *a, **kw):
+            self.messages = SimpleNamespace(create=self.create)
+        def create(self, **kw):
+            u = SimpleNamespace(input_tokens=100, output_tokens=20, cache_read_input_tokens=0)
+            system = kw["system"][0]["text"]
+            if kw.get("max_tokens") == 10:
+                return SimpleNamespace(content=[SimpleNamespace(text="SIMPLE")], usage=u)
+            sql = {CORRECT!r} if {LESSON!r} in system else {WRONG!r}
+            return SimpleNamespace(
+                content=[SimpleNamespace(type="text", text=json.dumps({{"sql": sql}}))], usage=u
+            )
+
+    anthropic.Anthropic = Fake
+    import entbench.harness as H
+    H.evaluate_task = lambda task, trace: "fiscal_quarter = 4" in json.dumps(
+        trace.node_results[-1].output
+    )
+    from entbench import rollout
+    sys.exit(rollout.main(sys.argv[1:]))
+    """
+)
+
+
+class ScriptedImprover(Proposer):
+    """Deterministic stand-in for the model-backed improver, in DemoProposer's shape."""
+
+    def call(self, mission, context_dir, label, **kwargs) -> Reply:
+        context = Path(context_dir)
+        workspace = None
+        if label.startswith("select."):
+            cands = sorted((context / "candidates").glob("*.md"))
+            good = [p.stem for p in cands if "fiscal_quarter = 4" in p.read_text()]
+            chosen = (good or [cands[0].stem])[0]
+            text = f"<why>Filters on the requested quarter.</why>\n```choice\n{chosen}\n```"
+        elif label.startswith("experience."):
+            agent = "sub_agents/sql_gen/AGENT.md"
+            changed = (context / "harness" / agent).read_text() != (
+                context / "base_harness" / agent
+            ).read_text()
+            text = (
+                "<edits>\ncomponent: sub_agents/sql_gen/AGENT.md\ncandidates: inv1\n"
+                "change: added the fiscal quarter convention\n"
+                "observed: the probe query filtered fiscal_quarter = 4; the base did not\n"
+                f"verdict: {'helped' if changed else 'no observed effect'}\n</edits>\n\n"
+            ) + (
+                "<experience>\ncue: When a question names a fiscal quarter\n"
+                "lesson: Filter on fiscal_quarter explicitly in sql_gen.\n"
+                "evidence: The sql_gen AGENT.md row -- the probe added the quarter filter the "
+                "base query omitted.\nconfidence: high for this observed contrast\n</experience>"
+                if changed
+                else "NO_ENTRY"
+            )
+        else:
+            workspace = context / "harness"
+            agent = workspace / "sub_agents" / "sql_gen" / "AGENT.md"
+            if LESSON not in agent.read_text():
+                agent.write_text(agent.read_text() + "\n" + LESSON + "\n")
+            text = "<notes>The base query dropped the Q4 filter.</notes>"
+        reply = Reply(label=label, text=text, ok=True, attempts=1, workspace=workspace)
+        self._calls.append(reply)
+        return reply
+
+
+@unittest.skipUnless(PAR_PY.exists(), "ENTBENCH_REPO with a .venv is required")
+class EntBenchAdapterTests(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        wrapper = self.root / "fake_rollout.py"
+        wrapper.write_text(FAKE_ROLLOUT, encoding="utf-8")
+        os.environ["ENTBENCH_REPO"] = str(REPO)
+        base = make_adapter("eb", None, "oc")
+        channel = ChannelSpec("opencode", "local/deterministic")
+        spec = dataclasses.replace(
+            base.spec,
+            runs_root=self.root / "runs",
+            channels={"proposer": channel, "selector": channel},
+        )
+        self.adapter = type(base)(repo=REPO, rollout_cmd=[str(PAR_PY), str(wrapper)], spec=spec)
+
+    def test_tasks_and_domains(self):
+        tasks = self.adapter.tasks()
+        self.assertEqual(len(tasks), 54)
+        self.assertEqual(self.adapter.domain_of("SQL-001"), "sql_gen")
+        self.assertEqual(len(self.adapter.reference_domain_order()), 7)
+
+    def test_task_prompt_hides_answers_and_hints(self):
+        for tid in self.adapter.tasks():
+            prompt = self.adapter.task_prompt(tid)
+            for leak in ("gold_", "bug_patterns", "known_trap", "evaluator", "antipattern"):
+                self.assertNotIn(leak, prompt, f"{tid} leaks {leak}")
+        self.assertIn("Adobe spend", self.adapter.task_prompt("SQL-001"))
+
+    def test_base_harness_is_valid_tree(self):
+        from harness2.benchmarks.entbench import PAR_SURFACE
+        from harness2.core import tree as HT
+
+        t = HT.read_tree(PAR_SURFACE, self.adapter.base_harness())
+        self.assertIn("sub_agents/sql_gen/AGENT.md", t)
+        HT.validate(PAR_SURFACE, t, allow_subagents=True)
+        self.adapter.validate_tree(t)
+
+    def test_validate_tree_feeds_back_actionable_errors(self):
+        from harness2.benchmarks.entbench import PAR_SURFACE
+        from harness2.core import tree as HT
+
+        t = HT.read_tree(PAR_SURFACE, self.adapter.base_harness())
+        del t["sub_agents/extract/AGENT.md"]
+        t["skills/x/SKILL.md"] = "---\nname: x\ndescription: y\n---\nbody"
+        with self.assertRaises(ValueError) as e:
+            self.adapter.validate_tree(t)
+        self.assertIn("extract/AGENT.md", str(e.exception))
+        self.assertIn("skills/", str(e.exception))
+
+    def test_execute_trajectory_deliverable_score(self):
+        run = self.adapter.execute("SQL-001", None, "base-r1")
+        self.assertTrue(self.adapter.delivered(run))
+        traj = self.adapter.trajectory(run, obs_trunc=50_000)
+        self.assertIn("[ACTION] planner", traj)
+        self.assertIn("[ACTION] sql_gen", traj)
+        self.assertNotIn("correct", traj)
+        self.assertIn(WRONG, self.adapter.deliverable_text(run))
+        self.assertEqual(self.adapter.score(run, "SQL-001")["all_pass"], False)
+        again = self.adapter.execute("SQL-001", None, "base-r1")
+        self.assertEqual(run, again)
+
+    def test_full_recursion_improves_and_grades(self):
+        prop = ScriptedImprover(self.adapter.spec.channels["proposer"])
+        result = schedule.run_domain(
+            "sql_gen",
+            ["SQL-001"],
+            1,
+            adapter=self.adapter,
+            prop=prop,
+            runs_root=self.adapter.spec.runs_root,
+            library_root=self.root / "library",
+        )
+        self.assertEqual((result["done"], result["failed"]), (1, 0))
+        summary_path = next(self.adapter.spec.runs_root.rglob("SQL-001/summary.json"))
+        summary = json.loads(summary_path.read_text())
+        selections = list(summary["selections"].values())
+        self.assertTrue(selections)
+        for sel in selections:
+            self.assertIn(CORRECT, self.adapter.deliverable_text(Path(sel["chosen_run_dir"])))
+        rows = judge.judge_selections(self.adapter, selections)
+        self.assertTrue(rows and all(r.all_pass for r in rows))
+        self.assertTrue(
+            list((self.root / "library").rglob("*.md"))
+            or list((self.root / "library").rglob("*.json"))
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
